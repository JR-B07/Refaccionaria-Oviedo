PROJECT_NAME="Refaccionaria ERP"
VERSION="1.0.0"

# ========================================
# ENVIRONMENT (development, production)
# ========================================
ENVIRONMENT=development
DEBUG=true
LOCAL_ID=1

# ========================================
# CONFIGURACIÓN DE MYSQL
# ========================================
# Opción 1: Para MySQL corriendo en localhost (desarrollo local)
MYSQL_SERVER=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=refaccionaria_db
MYSQL_PORT=3306

# Opción 2: Para conexión remota a MySQL (ej: Railway)
# DATABASE_URL=mysql+pymysql://usuario:contraseña@host:puerto/base_datos

# ========================================
# SEGURIDAD
# ========================================
SECRET_KEY="clave-secreta-de-ejemplo-cambiar-en-produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# CORS
# ========================================
# Para desarrollo local:
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# 
# Para producción en Railway:
# BACKEND_CORS_ORIGINS=["https://refaccionaria-oviedo-production.up.railway.app"]

# ========================================
# NOTAS PARA DEPLOYMENT EN RAILWAY
# ========================================
# 1. Establece ENVIRONMENT=production
# 2. Configura DATABASE_URL con tus credenciales de MySQL
# 3. Actualiza SECRET_KEY con una clave segura
# 4. Railway proporciona HTTPS automáticamente
# 5. El servidor escucha en puerto 8000, Railway maneja el reverse proxy
